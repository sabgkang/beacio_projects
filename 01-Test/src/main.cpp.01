#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include <BLE2902.h>

// 定義您的服務與特徵值 UUID (必須與您前端 JavaScript 寫的一致)
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;
bool oldDeviceConnected = false;
uint32_t value = 0;

// 監聽藍牙連線狀態的 Callback
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      Serial.println(">> iPhone (Safari/beacio) 已成功連線！");
    };

    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      Serial.println(">> iPhone 已斷開連線。");
    }
};

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("正在初始化 ESP32-S3 BLE...");

  // 1. 初始化 BLE 裝置，設定裝置名稱
  BLEDevice::init("ESP32-S3-WebBLE");

  // 2. 建立 BLE 伺服器並設定狀態回呼
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());

  // 3. 建立 BLE 服務
  BLEService *pService = pServer->createService(SERVICE_UUID);

  // 4. 建立特徵值（支援讀取、寫入、以及主動通知功能）
  pCharacteristic = pService->createCharacteristic(
                      CHARACTERISTIC_UUID,
                      BLECharacteristic::PROPERTY_READ   |
                      BLECharacteristic::PROPERTY_WRITE  |
                      BLECharacteristic::PROPERTY_NOTIFY
                    );

  // 讓 iOS 能夠順利訂閱 Notify 的必要描述符
  pCharacteristic->addDescriptor(new BLE2902());

  // 設定初始數值
  pCharacteristic->setValue("Hello from ESP32-S3!");

  // 5. 啟動服務
  pService->start();

  // 🌟【關鍵步驟】配置廣播數據，讓 Safari 找得到
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  
  // 必須：將 Service UUID 塞入廣播封包中，否則 Safari 的 Web Bluetooth filter 會濾掉它
  pAdvertising->addServiceUUID(SERVICE_UUID);
  
  // 選填：允許掃描回應（Scan Response），這能讓裝置名稱更完整地出現在選單中
  pAdvertising->setScanResponse(true);
  
  // 針對 iOS 優化（有助於縮短連線等待時間）
  pAdvertising->setMinPreferred(0x06);  
  pAdvertising->setMinPreferred(0x12);  
  
  // 6. 開始廣播
  BLEDevice::startAdvertising();
  Serial.println("ESP32-S3 藍牙廣播中...請開啟 iPhone Safari 測試。");
}

void loop() {
    // 當連線成功時，每隔 2 秒自動遞增數字並傳送給 iPhone (測試 Notify 功能)
    if (deviceConnected) {
        value++;
        String payload = "Data: " + String(value);
        pCharacteristic->setValue(payload.c_str());
        pCharacteristic->notify(); // 主動推播給網頁
        Serial.printf("發送通知給網頁: %s\n", payload.c_str());
        delay(2000);
    }

    // 處理斷線後重新啟動廣播的邏輯，避免斷開後 iPhone 就找不到裝置
    if (!deviceConnected && oldDeviceConnected) {
        delay(500); // 讓藍牙堆疊有時間準備
        pServer->startAdvertising(); // 重新開始廣播
        Serial.println("已重啟藍牙廣播...");
        oldDeviceConnected = deviceConnected;
    }
    
    if (deviceConnected && !oldDeviceConnected) {
        oldDeviceConnected = deviceConnected;
    }
}
